---
import Layout from "~/layouts/Layout.astro";
import BlogArchive from "~/components/BlogArchive.astro";
import { getPostsByTopic, getPublishedTopics, paginate, totalPagesFor } from "~/utils/blog";
import { clampDescription } from "~/utils/seo";

export async function getStaticPaths() {
	const topics = await getPublishedTopics();
	const paths = [];

	for (const topic of topics) {
		const posts = await getPostsByTopic(topic.id);
		const totalPages = totalPagesFor(posts);

		for (let page = 2; page <= totalPages; page++) {
			paths.push({
				params: { slug: topic.id, page: String(page) },
				props: { topic, page, posts: paginate(posts, page), totalPages },
			});
		}
	}

	return paths;
}

const { topic, page, posts, totalPages } = Astro.props;
const topics = await getPublishedTopics();
---

<Layout title={topic.name + " - Page " + page} description={clampDescription(topic.description)}>
	<BlogArchive
		title={topic.name}
		description={topic.description}
		posts={posts}
		page={page}
		totalPages={totalPages}
		basePath={"/topics/" + topic.id}
		topics={topics}
		activeTopic={topic.id}
	/>
</Layout>
