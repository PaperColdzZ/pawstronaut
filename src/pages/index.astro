---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import { Image, Picture } from "astro:assets";
import Hero from "~/components/Hero.astro";
import Button from "~/components/Button.astro";
import Faq from "~/components/Faq.astro";
import CallToAction from "~/components/CallToAction.astro";
import ShowCats from "~/components/ShowCats.astro";
import ShowBlogs from "~/components/ShowBlogs.astro";
import Heading from "~/components/Heading.astro";
import CatNameGenerator from "~/components/CatNameGenerator.astro";
import CardBenefit from "~/components/CardBenefit.astro";
import SceneStack from "~/components/SceneStack.astro";
import GuideCards from "~/components/GuideCards.astro";
import HealthCard from "~/components/HealthCard.astro";
import { siteTitle, siteDescription } from "~/data/config";

// Images
import CatBackground from "~/assets/images/meepal-hero.png";
import CatOne from "~/assets/images/pexels-chevonrossouw-2558605.jpg";
import CatTwo from "~/assets/images/pexels-minan1398-1003994.jpg";

// 4 advantages 区块的插画素材（从参考项目 purrfectly-zen-astro 复制而来，MIT 许可）
import BenefitIconChill from "~/assets/images/meditating_cat_illustration.png";
import BenefitIconPlayful from "~/assets/images/playful_cat_illustration.png";
import BenefitIconFood from "~/assets/images/cat_with_food_illustration.png";

// 「Life, with a little more life in it.」区块右侧三张叠放卡片的配图
import SceneCard1 from "~/assets/images/scene-card1.jpeg";
import SceneCard2 from "~/assets/images/scene-card2.jpeg";
import SceneCard3 from "~/assets/images/scene-card3.jpeg";
import GuideCardCat from "~/assets/images/guide-card-cat.avif";
import GuideCardDog from "~/assets/images/guide-card-dog.avif";
// dog health 区块右侧卡片配图
import DogHealthCard from "~/assets/images/dog-health-card.avif";

// Faq
const faq = [
	{
		question: "What is the adoption process?",
		answer: "The adoption process is simple. You can view our available pets on our website. If you see a pet you are interested in, you can contact us to schedule a meet and greet. If you decide to adopt the pet, you will need to fill out an adoption application and pay the adoption fee. Once the adoption is complete, you can take your new pet home!",
	},
	{
		question: "What is the adoption fee?",
		answer: "The adoption fee varies depending on the pet. The fee covers the cost of spaying/neutering, vaccinations, microchipping, and other medical expenses. The fee also helps support our shelter and the care of our animals.",
	},
	{
		question: "Can I adopt a pet if I live out of state?",
		answer: "Yes, you can adopt a pet if you live out of state. However, you will need to come to our shelter to meet the pet and complete the adoption process. We do not ship pets, so you will need to pick up your new pet in person.",
	},
	{
		question: "Do you have a return policy?",
		answer: "Yes, we have a return policy. If for any reason you are unable to keep your adopted pet, you can return the pet to our shelter. We want to ensure that all of our pets find loving forever homes, so we are here to help if you need to return a pet.",
	},
];

// Trust badges（信任徽章）：与模板其他图标写法一致 —— Heroicons v2 outline 内联 SVG，不引入图标库依赖
const badges = [
	{
		label: "5 Rated",
		color: "text-amber-300",
		path: "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z",
	},
	{
		label: "100% Free",
		color: "text-emerald-300",
		path: "M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z",
	},
	{
		label: "Science-Backed",
		color: "text-violet-300",
		path: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
	},
	{
		label: "Community Loved",
		color: "text-rose-300",
		path: "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z",
	},
];
// 「4 advantages」区块的卡片数据（占位内容）：文案与插画后续都要替换成真实的宠物喂养主题
// 注意：参考项目只有 3 张插画，第 4 张暂时复用第 3 张，等有第 4 张素材时改这里即可
const benefits = [
	{
		image: BenefitIconChill,
		title: "Master of Chill",
		text: "Learn the ancient art of doing absolutely nothing and looking fabulous while doing it.",
	},
	{
		image: BenefitIconPlayful,
		title: "Playful Spirit",
		text: "Rediscover your inner kitten. Chase dreams (and butterflies) with reckless abandon.",
	},
	{
		image: BenefitIconFood,
		title: "Soul Nourishment",
		text: "Feed your heart with unconditional love, head bumps, and the occasional slow blink.",
	},
	{
		// 占位：这一张暂时复用上面的插画
		image: BenefitIconFood,
		title: "Soul Nourishment",
		text: "Feed your heart with unconditional love, head bumps, and the occasional slow blink.",
	},
];

// 场景卡片数据（占位）：图片用项目里已经就位的 scene-card1~3.jpeg
// 标题/描述沿用参考稿的占位文案，等正式内容替换；alt 暂时用标题兜底，正式上线前补成图片描述
const scenes = [
	{ image: SceneCard1, number: "01", title: "Slow mornings", text: "A warm spot, a soft nap and nowhere else to be." },
	{ image: SceneCard2, number: "02", title: "Outside together", text: "Fresh air is better when every leaf is exciting." },
	{ image: SceneCard3, number: "03", title: "Anywhere feels like home", text: "Pack the treats. Keep the favorite blanket close." },
];

// 「起步指南」卡片数据（占位）：两张配图用项目里已经就位的 guide-card-cat/dog.avif
// href 暂时指向现有页面（还没有真正的 cat / dog 指南页），等指南页做好再换
const guides = [
	{
		image: GuideCardCat,
		alt: "Cat looking at the camera",
		tone: "yellow" as const,
		title: "Bring your cat home with confidence",
		text: "A calm first week, room by room.",
		href: "/topics/adoption/",
	},
	{
		image: GuideCardDog,
		alt: "Happy golden retriever outdoors",
		tone: "mint" as const,
		title: "Build good habits from day one",
		text: "Simple routines for a happy start.",
		href: "/blog/",
	},
];
---

<Layout title={siteTitle} description={siteDescription} exactTitle>
	<Section class:list={"relative"}>
		<Picture
			src={CatBackground}
			alt="Cat"
			class:list={"absolute inset-0 w-full h-full object-cover"}
			loading={"eager"}
			fetchpriority={"high"}
		/>
		<div class="bg-gradient-to-r from-fuchsia-500/60 to-teal-500/80 absolute inset-0"></div>
		<Container class:list={"relative z-10 h-full lg:min-h-svh lg:h-svh"}>
			<div class="flex items-center h-full">
				<div class="mr-auto">
					<div class="prose prose-xl prose-invert text-white lg:text-left text-balance">
						<h1 class="text-5xl lg:text-8xl mb-0">Welcome to our pet shelter!</h1>
						<p class="max-w-2xl">
							Warm, practical guidance for raising
							happy cats and dogs without second-guessing every little thing.
						</p>

						<div class="not-prose mt-6 flex flex-wrap gap-3">
							{badges.map(({ label, color, path }) => (
								<span class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/20 px-3 py-2 shadow-sm backdrop-blur-sm">
									<svg
										class={`size-4 shrink-0 ${color}`}
										fill="none"
										viewBox="0 0 24 24"
										stroke-width="1.5"
										stroke="currentColor"
										aria-hidden="true"
										data-slot="icon"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d={path} />
									</svg>
									<span class="text-xs font-semibold text-white">{label}</span>
								</span>
							))}
						</div>

						<div class="not-prose mt-8">
							<Button url="/cats" color="white"> Adopt now! </Button>
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<!-- ===================== 4 advantages 区块（占位内容） ===================== -->
	<!-- 结构与参考项目 purrfectly-zen-astro 的 Features 区块一致；单张卡片见 components/CardBenefit.astro -->
	<Section>
		<Container>
			<!-- 居中标题组：沿用 Heading.astro 的排版约束（max-w-3xl + prose），额外加 mx-auto / text-center 让它居中 -->
			<div class="mx-auto mb-16 max-w-3xl prose text-center">
				<!-- 眉标：用模板自带的手写体 font-caveat + 品牌色，对应参考项目里的 font-hand -->
				<!-- block + mb-2：让眉标自成一行并贴近标题（否则 typography 插件会给 h2 一大段 margin-top） -->
				<span class="block font-caveat text-2xl text-brand-teal mb-2">4 advantages</span>
				<h2 class="h2 text-teal-500 mt-0">The Benefits of Feeding a Pet</h2>
				<p>
					We have a variety of cats available for adoption. Please take a look at our available cats and
					contact us if you are interested in adopting one.
				</p>
			</div>

			<!-- 卡片网格：手机 1 列 -> 小屏 2 列 -> 桌面 4 列（数据来自上方 benefits 数组） -->
			<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{benefits.map((benefit) => <CardBenefit {...benefit} />)}
			</div>
		</Container>
	</Section>

	<!-- 已隐藏（2026-09-15 按用户要求）：原来的「Adopt a pet today!」区块。整段代码原样保留在此，
	恢复时只要删掉这一对注释标记即可。
	<Section class:list={"bg-white"}>
		<Container>
			<Hero>
				<div slot="hero-content-left" class="prose">
					<h2 class="h2 text-teal-500">Adopt a pet today!</h2>
					<p class="leading-loose">
						We have a variety of pets available for adoption. Please take a look at our available pets and
						contact us if you are interested in adopting one. We are always looking for loving homes for our
						pets. Thank you for considering adoption!
					</p>

					<div class="not-prose mt-16">
						<Button url="/cats">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="inline-block size-5 -mt-1 mr-1"
								viewBox="0 0 14 14"
								><path
									fill="currentColor"
									fill-rule="evenodd"
									d="M1.777.053A.5.5 0 0 1 2.3.1l3.917 2.947a6.6 6.6 0 0 1 1.564 0L11.7.1a.5.5 0 0 1 .801.4v8.25h.748a.75.75 0 0 1 0 1.5h-.81a4.5 4.5 0 0 1-.479 1.391l1.376.688a.75.75 0 1 1-.67 1.342l-1.654-.827A4.48 4.48 0 0 1 8 14H6a4.48 4.48 0 0 1-3.011-1.156l-1.654.827a.75.75 0 1 1-.67-1.342l1.376-.688a4.5 4.5 0 0 1-.479-1.391h-.81a.75.75 0 0 1 0-1.5H1.5V.5a.5.5 0 0 1 .277-.447M9.124 7.75a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m-4.25 0a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m.897 1.605A.5.5 0 0 1 6.25 9h1.5a.5.5 0 0 1 .277.916l-.75.5a.5.5 0 0 1-.554 0l-.75-.5a.5.5 0 0 1-.202-.56Z"
									clip-rule="evenodd"></path></svg
							>
							Adopt a cat
						</Button>
					</div>
				</div>
				<div slot="hero-content-right" class="-rotate-1">
					<Image src={CatOne} alt="Cat" class:list={"w-full h-full object-cover rounded-2xl shadow"} />
				</div>
			</Hero>
		</Container>
	</Section>
	-->

	<!-- 新区域（2026-09-15）：左侧文案 + 右侧可点击切换显示顺序的叠放卡片 -->
	<Section class:list={"bg-white"}>
		<Container>
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-5 lg:gap-20">
				<!-- 左侧文案（占位）：标题与首段沿用参考稿，第二段是我写的占位说明，等正式文案替换 -->
				<div class="prose lg:col-span-2">
					<h2 class="h2 text-teal-500">Life, with a little more life in it.</h2>
					<p>Not every moment is picture-perfect. Somehow, they're still the ones you keep.</p>
					<p class="text-gray-600">
						Placeholder paragraph — replace with the final copy. Two or three sentences read best
						here, and they keep the card stack from sliding too far down the page.
					</p>
				</div>

				<!-- 右侧：三张叠在一起的卡片，点任意一张即可把它翻到最前面 -->
				<div class="lg:col-span-3">
					<SceneStack scenes={scenes} />
				</div>
			</div>
		</Container>
	</Section>

	<!-- guides 区块（2026-09-15 新增）：左文案 + 右侧两张「起步指南」卡片，结构来自参考稿的 <section class="guides"> -->
	<Section class:list={"bg-white"}>
		<Container>
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-5 lg:gap-20">
				<!-- 左侧文案（占位）：眉标 / 标题 / 引导语沿用参考稿原文，等正式文案替换 -->
				<div class="lg:col-span-2">
					<span class="block text-xs font-bold uppercase tracking-[0.18em] text-brand-fuchsia">New here?</span>
					<h2 class="h2 mt-4 text-teal-500">Start with the animal already in your life.</h2>
					<p class="mt-6 max-w-sm text-gray-600">
						No perfect pet-parent test. Just useful, reassuring advice for the first days and all the days
						after.
					</p>
				</div>

				<!-- 右侧：两张纯色卡片（数据来自上方 guides 数组，单卡见 components/GuideCards.astro） -->
				<div class="lg:col-span-3">
					<GuideCards guides={guides} />
				</div>
			</div>
		</Container>
	</Section>

	<Section>
		<Container>
			<Heading>
				<h2 slot="heading-title" class="h2 text-teal-500">News from our shelter</h2>
				<p slot="heading-content">
					Welcome to our blog! Here you will find the latest news and updates from our pet shelter. We are
					passionate about helping pets find loving forever homes, and we are excited to share our stories
					with you. Thank you for supporting our shelter!
				</p>
			</Heading>

			<ShowBlogs posts={["hello-world", "new-arrival-luna", "new-site-launched"]} />
		</Container>
	</Section>

	<!-- <Section>
		<Container>
			<Heading>
				<h2 slot="heading-title" class="h2 text-teal-500">Available Cats</h2>
				<p slot="heading-content">
					We have a variety of cats available for adoption. Please take a look at our available cats and
					contact us if you are interested in adopting one. We are always looking for loving homes for our
					cats. Thank you for considering adoption!
				</p>
			</Heading>

			<ShowCats cats={["reckoning", "chairman-meow", "pawdre-hepburn"]} />
		</Container>
	</Section> -->

	<!-- dog health 区块（2026-09-15 新增）：左文案 + 右侧浅绿卡片，结构来自参考稿的 <section class="dog-health"> -->
	<Section class:list={"bg-white"}>
		<Container>
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
				<!-- 左侧文案（占位）：眉标 / 标题 / 正文沿用参考稿原文，等正式文案替换 -->
				<div>
					<span class="block text-xs font-bold uppercase tracking-[0.18em] text-brand-fuchsia">Dog health</span>
					<h2 class="h2 mt-4 text-teal-500">
						Healthy smile.<br />Happier dog.
					</h2>
					<p class="mt-6 max-w-sm text-gray-600">
						Dental care feels small — until it changes mealtimes, playtime and every close-up hello.
					</p>

					<!-- 主 CTA：参考稿这里是实心深色胶囊，hover 反转为描边。颜色换成本站品牌色 teal-900 -->
					<div class="mt-8">
						<a
							href="/blog/"
							class="inline-flex w-fit items-center gap-2 rounded-full border-2 border-teal-900 bg-teal-900 px-5 py-2.5 text-sm font-bold text-white transition-colors duration-300 hover:bg-transparent hover:text-teal-900"
						>
							Read the dental guide <span aria-hidden="true">→</span>
						</a>
					</div>
				</div>

				<!-- 右侧：浅绿卡片（单卡组件见 components/HealthCard.astro） -->
				<HealthCard
					image={DogHealthCard}
					alt="French bulldog in a yellow sweater"
					title="A beginner’s guide to dog dental care"
				/>
			</div>
		</Container>
	</Section>

	<Section class:list={"bg-white"}>
		<Container>
			<Hero invert>
				<div slot="hero-content-left" class="prose">
					<h2 class="h2 text-fuchsia-500">FAQ</h2>
					<Faq items={faq} color="fuchsia" />
				</div>
				<div slot="hero-content-right" class="rotate-1">
					<Image src={CatTwo} alt="Cat" class:list={"w-full h-full object-cover rounded-2xl shadow"} />
				</div>
			</Hero>
		</Container>
	</Section>

	<!-- <Section class:list={"relative"}>
		<Image src={CatBackground} alt="Cat" class:list={"absolute inset-0 w-full h-full object-cover"} />
		<div class="bg-gradient-to-r from-fuchsia-900/80 to-teal-900/80 absolute inset-0"></div>

		<Container class:list={"relative z-10"}>
			<CallToAction
				title="Contact us today to adopt a cat"
				link={{ title: "Adopt", url: "/cats", color: "white" }}
			/>
		</Container>
	</Section> -->

	<Section class:list={"relative"}>
		<Image src={CatBackground} alt="Cat" class:list={"absolute inset-0 w-full h-full object-cover"} />
		<div class="bg-gradient-to-r from-fuchsia-900/80 to-teal-900/80 absolute inset-0"></div>

		<Container class:list={"relative z-10"}>
			<CatNameGenerator title="Help me name my new cat!" />
		</Container>
	</Section>
</Layout>
