---
import { archivePath } from "~/utils/blog";

const { current = 1, total = 1, basePath = "/blog" } = Astro.props;

const pill = "rounded-full px-4 py-1.5 text-base font-semibold transition";
const idle = pill + " ring-1 ring-gray-200 hover:text-brand-fuchsia hover:ring-brand-fuchsia";
const currentClass = pill + " bg-brand-teal text-white";
const disabled = pill + " text-gray-500/60 ring-1 ring-gray-200";

// Window of page numbers around the current page, with a gap marker when truncated.
const items: (number | "gap")[] = [];
for (let page = 1; page <= total; page++) {
	const isEdge = page === 1 || page === total;
	const isNear = Math.abs(page - current) <= 2;
	if (isEdge || isNear) {
		items.push(page);
	} else if (items[items.length - 1] !== "gap") {
		items.push("gap");
	}
}
---

{
	total > 1 && (
		<nav aria-label="Pagination" class="not-prose mt-16 flex flex-wrap items-center justify-center gap-2">
			{current > 1 ? (
				<a href={archivePath(basePath, current - 1)} rel="prev" class={idle}>
					Previous
				</a>
			) : (
				<span class={disabled} aria-disabled="true">
					Previous
				</span>
			)}

			{items.map((item) =>
				item === "gap" ? (
					<span class="px-2 text-gray-500/60" aria-hidden="true">
						...
					</span>
				) : item === current ? (
					<span class={currentClass} aria-current="page">
						{item}
					</span>
				) : (
					<a href={archivePath(basePath, item)} class={idle} aria-label={"Page " + item}>
						{item}
					</a>
				),
			)}

			{current < total ? (
				<a href={archivePath(basePath, current + 1)} rel="next" class={idle}>
					Next
				</a>
			) : (
				<span class={disabled} aria-disabled="true">
					Next
				</span>
			)}
		</nav>
	)
}
