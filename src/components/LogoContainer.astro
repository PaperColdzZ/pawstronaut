---
import { Image } from "astro:assets";
import Logo from "~/assets/images/logo-pawstronaut.svg";
import { siteSlogan, siteName } from "~/data/config.js";
---

<div class="flex items-center gap-2 lg:gap-6">
    <Logo class="w-auto h-8 lg:h-12" />

    <div>
        <span class="block font-caveat text-xl lg:text-4xl font-semibold">{siteName}</span>
        <p class="max-lg:hidden text-sm text-center italic">{siteSlogan}</p>
    </div>
</div>
