---
/**
 * CardBenefit —— 「利益点」卡片（首页 4 advantages 区块用）
 *
 * 结构参考：参考项目 purrfectly-zen-astro 的 FeatureCard（HomePage.tsx:307-347）。
 * 原实现是 React + framer-motion；这里按本项目的做法改写为纯 Astro 组件，
 * 入场动画改为 CSS transition（不引入任何 JS 依赖）。
 */
import { Image } from "astro:assets";

interface Props {
	/** 插画（astro:assets 导入的图片资源），必填 */
	image: ImageMetadata;
	/** 插画的替代文本；不传时退回用 title */
	alt?: string;
	/** 卡片标题 */
	title?: string;
	/** 卡片正文 */
	text?: string;
}

const { image, alt = "", title = "", text = "" } = Astro.props;
---

<!-- 单张利益点卡片：上方插画区 + 下方文字区，整体白底圆角卡 -->
<article
	class="h-full flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow duration-300 hover:shadow-xl"
>
	<!-- 插画区：固定高度 h-48，插画等比缩放后在中间居中 -->
	<div class="flex h-48 items-center justify-center bg-teal-50 p-8">
		<Image
			src={image}
			alt={alt || title}
			width={256}
			height={256}
			class:list={"h-32 w-auto object-contain"}
		/>
	</div>

	<!-- 文字区：flex-1 保证同一行卡片高度一致、文字垂直居中 -->
	<div class="flex flex-1 flex-col items-center p-8 text-center">
		<h3 class="h5 mb-3">{title}</h3>
		<p>{text}</p>
	</div>
</article>
